    "@xrpl-indexer/xrpl-client": "workspace:*",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
