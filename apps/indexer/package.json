{
  "name": "@xrpl-indexer/indexer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "backfill": "tsx src/main.ts --mode=backfill",
