{
  "name": "xrpl-indexer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @xrpl-indexer/db generate",
    "db:migrate": "pnpm --filter @xrpl-indexer/db migrate",
    "db:studio": "pnpm --filter @xrpl-indexer/db studio",
    "bootstrap": "pnpm --filter @xrpl-indexer/db bootstrap"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
