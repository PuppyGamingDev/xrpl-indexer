# ---------------------------------------------------------------------------
# Shared
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# Postgres (matches docker-compose.yml). Remote workers point this at the
# indexing host's Postgres — add ?sslmode=require over the public internet.
DATABASE_URL=postgres://xrpl:xrpl@localhost:5432/xrpl_indexer
# Postgres pool size PER PROCESS (default 10). Lower it on boxes running many
# worker processes so you stay under the server's max_connections.
# DB_POOL_MAX=6

# ---------------------------------------------------------------------------
# apps/indexer
# ---------------------------------------------------------------------------
# Shared fallback endpoint list (comma-separated ws/wss rippled or Clio URLs).
# Used for both live sync and backfill when the mode-specific lists below are unset.
XRPL_ENDPOINTS=wss://xrplcluster.com,wss://s2.ripple.com
#
# Live `ledger` subscription + catch-up. A non-full-history node (e.g. your own
# Clio) is ideal — it only needs recent ledgers. Defaults to XRPL_ENDPOINTS.
# XRPL_SYNC_ENDPOINTS=wss://my-clio.internal:6006
#
# Historical range/gap backfill. MUST serve old ledgers — point at a full-history
# rippled/Clio (your own or a public one). Defaults to XRPL_ENDPOINTS.
# The live syncer also falls back to these if it hits a ledger its sync node has
# already pruned (e.g. after a long outage).
# XRPL_BACKFILL_ENDPOINTS=wss://xrplcluster.com,wss://s2.ripple.com
#
# Initial full-state `ledger_data` snapshot. Point at your OWN Clio — public
# proxies cap ledger_data pages hard (~75/page vs 2048), making it ~25x slower.
# Defaults to XRPL_SYNC_ENDPOINTS, then XRPL_ENDPOINTS.
# XRPL_SNAPSHOT_ENDPOINTS=wss://my-clio.internal:6006
#
# On live-mode start, if a full state snapshot has never completed (tracked in
# the `snapshot_state` table) run it first, then live sync catches up. Set false
# to keep "delta-only from start" behaviour. Resumable — safe to restart mid-run.
INDEXER_SNAPSHOT_ON_START=true
#
# Ledger to start live sync from ("current" = whatever validates next)
INDEXER_START_LEDGER=current
#
# Record EVERY account's native XRP balance on every change (fees included).
# This is the single largest table — leave false unless you specifically want
# XRP rich-list / per-account XRP history. AMM/Vault pseudo-accounts are always
# tracked (needed for pool reserves); IOU/MPT balances + all metrics are
# unaffected. Roughly ~50 rows/ledger (~1M/day) when true, ~0 when false.
INDEXER_TRACK_XRP_BALANCES=false
#
# Historical backfill floor (0 = no backfill; set to a ledger index to fill down to)
INDEXER_BACKFILL_FLOOR=0
INDEXER_METRICS_PORT=9101
INDEXER_BACKFILL_CONCURRENCY=4

# ---------------------------------------------------------------------------
# apps/api
# ---------------------------------------------------------------------------
API_PORT=4100
API_RESPONSE_CACHE_TTL_MS=4000
API_HOLDERS_CACHE_TTL_MS=300000
API_DEFAULT_IPFS_GATEWAY=https://ipfs.io

# ---------------------------------------------------------------------------
# apps/backfiller + apps/worker
# ---------------------------------------------------------------------------
# Workers are fully decoupled: they only need DATABASE_URL + outbound HTTPS, so
# they can run on any other VPS/machine. Run apps/backfiller on exactly ONE box
# (it holds the schedules + discovery loop); scale apps/worker anywhere.
#
# Which pg-boss queues THIS worker process services (comma-separated) + concurrency.
# Split roles across machines, e.g.
#   box A:  WORKER_QUEUES=nft.collection            (the ONLY box with a Bithomp key)
#   box B:  WORKER_QUEUES=nft.metadata              (IPFS — safe to run many)
#   box C:  WORKER_QUEUES=token.metadata,issuer.metadata,stats.rollup
WORKER_QUEUES=nft.metadata,token.metadata,issuer.metadata
WORKER_CONCURRENCY=25
BACKFILLER_METRICS_PORT=9102
WORKER_METRICS_PORT=9103

# IPFS / Arweave gateways used ONLY to fetch metadata JSON (never persisted)
METADATA_GATEWAYS=https://ipfs.io,https://cloudflare-ipfs.com,https://gateway.pinata.cloud
ARWEAVE_GATEWAY=https://arweave.net

# Source providers (all optional — omit a key to disable that provider)
BITHOMP_API_KEY=
BITHOMP_BASE_URL=https://bithomp.com/api/v2
BITHOMP_REQUESTS_PER_MINUTE=300
XRPLTO_BASE_URL=https://api.xrpl.to/api
XRPLMETA_BASE_URL=https://s1.xrplmeta.org

# ---------------------------------------------------------------------------
# apps/dashboard  (server-only — never expose to the browser / never NEXT_PUBLIC_*)
# ---------------------------------------------------------------------------
XRPL_API_BASE_URL=http://localhost:4100
XRPL_API_KEY=
XRPL_API_ADMIN_KEY=
AUTH_SECRET=change-me-32-bytes-min
# First dashboard operator, seeded by `pnpm bootstrap`
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASSWORD=change-me
